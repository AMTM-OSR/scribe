# put wlceventd Assoc/ReAssoc/Disassoc messages into /opt/var/log/wlceventd.log

################################################
# This configuration file now includes the
# the system new "/jffs/wifi_wlc.log" file
# as a 'source' for the filtered log file.
# Last Modified: 2026-Sep-29
################################################
source s_wifi_wlc {
      wildcard_file(base_dir("/jffs")
                  filename_pattern("wifi_wlc.log")
                  recursive(no) max-files(1)
                  follow-method(inotify)
                  monitor-method(inotify)
                  log_fetch_limit(500));
};

destination d_wlceventd { 
    file("/opt/var/log/wlceventd.log");
};

filter f_wlceventd {
    ( ( program('WLCEVENTD') or
        program('wlceventd') or
        message('wlceventd_proc_event') )
      and
      ( message('Auth') or 
        message('Assoc') or
        message('Deauth') or
        message('Disassoc') )
    ) or
    ( message('main\([0-9]+\)') and message('wlceventd') )
    or
    ( program('syslog') and message('wlceventd') );
};

log {
    source(src);
    source(s_wifi_wlc);
    filter(f_wlceventd);
    destination(d_wlceventd);
    flags(final);
};

#eof
